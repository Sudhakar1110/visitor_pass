{
 "css": "@page { size: auto; margin: 10mm; }\n.print-format { background: #ffffff; }\n",
 "custom_format": 1,
 "disabled": 0,
 "doc_type": "Entry Pass",
 "doctype": "Print Format",
 "font_size": 14,
 "html": "{% set visitor_photo = frappe.db.get_value(\"Visitor\", doc.visitor, \"photo\") if doc.visitor and frappe.db.exists(\"Visitor\", doc.visitor) else None %}\n<div class=\"text-center\" style=\"border: 3px solid #2490ef; border-radius: 10px; padding: 22px; max-width: 480px; margin: 0 auto; font-family: Arial, Helvetica, sans-serif;\">\n\t<div style=\"font-size: 11px; letter-spacing: 3px; color: #2490ef; font-weight: bold; text-transform: uppercase;\">Visitor Entry Pass</div>\n\t<div style=\"font-size: 28px; font-weight: bold; margin: 8px 0 2px;\">{{ doc.visitor_name }}</div>\n\t{% if visitor_photo %}\n\t<div style=\"margin: 12px auto;\"><img src=\"{{ visitor_photo }}\" style=\"width: 100px; height: 100px; object-fit: cover; border-radius: 50%; border: 3px solid #d1d8dd;\"></div>\n\t{% endif %}\n\t<table style=\"width: 100%; font-size: 13px; margin-top: 10px;\">\n\t\t<tr><td style=\"padding: 4px 8px; color: #6c7680;\">Pass No.</td><td style=\"padding: 4px 8px; font-weight: bold;\">{{ doc.name }}</td></tr>\n\t\t<tr><td style=\"padding: 4px 8px; color: #6c7680;\">Host</td><td style=\"padding: 4px 8px;\">{{ doc.host or \"-\" }}</td></tr>\n\t\t<tr><td style=\"padding: 4px 8px; color: #6c7680;\">Gate</td><td style=\"padding: 4px 8px;\">{{ doc.location_gate or \"-\" }}</td></tr>\n\t\t<tr><td style=\"padding: 4px 8px; color: #6c7680;\">Valid From</td><td style=\"padding: 4px 8px;\">{{ frappe.utils.format_datetime(doc.valid_from) }}</td></tr>\n\t\t<tr><td style=\"padding: 4px 8px; color: #6c7680;\">Valid Till</td><td style=\"padding: 4px 8px;\">{{ frappe.utils.format_datetime(doc.valid_till) }}</td></tr>\n\t\t<tr><td style=\"padding: 4px 8px; color: #6c7680;\">Status</td><td style=\"padding: 4px 8px; font-weight: bold;\">{{ doc.status }}</td></tr>\n\t</table>\n\t{% if doc.qr_code %}\n\t<div style=\"margin-top: 16px;\"><img src=\"{{ doc.qr_code }}\" style=\"width: 150px; height: 150px;\"></div>\n\t<div style=\"font-size: 10px; color: #6c7680; margin-top: 6px;\">Scan this code at the gate on arrival</div>\n\t{% endif %}\n</div>",
